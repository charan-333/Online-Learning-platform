# Copy to server/.env (or export in your shell). Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://cat100:cat100@localhost:5432/cat100
TEST_DATABASE_URL=postgres://cat100:cat100@localhost:5432/cat100_test
# Comma-separated list of browser origins allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:5173
# Public URL used in password-reset links.
APP_URL=http://localhost:5173
SESSION_TTL_DAYS=14
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
LOG_LEVEL=info

# AI tutor. With AI_PROVIDER=none the tutor answers from platform content only.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=            # server-side only; never exposed to the browser
AI_MODEL=claude-opus-5-5
AI_DAILY_MESSAGE_LIMIT=50

# Optional: create an admin on `npm run db:seed`.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-this-long-password

# Where uploaded diagrams are stored (served at /uploads).
# UPLOAD_DIR=uploads
